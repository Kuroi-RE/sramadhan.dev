# Chatbot API configuration (server-only)
# Development (Omniroute / 9router local):
CHAT_API_BASE_URL=http://localhost:20128/v1
# Production (shaaram.id):
# CHAT_API_BASE_URL=https://shaaram.id/v1
CHAT_API_KEY=your_api_key_here
CHAT_MODEL=combo
CHAT_STREAM=true

# GitHub Personal Access Token (optional, raises rate limit)
GITHUB_TOKEN=
